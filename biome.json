{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/storybook-static", "!registry/r", "!**/.turbo", "!.playwright-mcp"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": { "noArrayIndexKey": "off" },
      "a11y": { "noLabelWithoutControl": "off" },
      "correctness": { "useHookAtTopLevel": "off" }
    }
  }
}
