{
  "name": "nova-design-system",
  "private": true,
  "description": "Nova Design System — tokens, React components, docs and handoff tooling.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@nova/docs...",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook": "pnpm --filter @nova/docs dev",
    "build:storybook": "turbo run build-storybook",
    "registry:build": "node scripts/build-registry.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:storybook && pnpm registry:build",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
