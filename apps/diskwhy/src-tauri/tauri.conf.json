{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskWhy",
  "version": "0.2.1",
  "identifier": "th.co.nova.diskwhy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "node scripts/build-cli.mjs && pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "title": "DiskWhy — ดิสก์เต็มเพราะอะไร",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "ดิสก์เต็มเพราะอะไร — วิเคราะห์พื้นที่ดิสก์",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Thai",
          "English"
        ]
      }
    },
    "resources": {
      "binaries/diskwhy-cli.exe": "binaries/diskwhy-cli.exe"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRUFERDEzMzQ3N0FGQjIKUldTeXIzYzBFOTNxVTQyVCtvNmpBM2pCdWYwU0JYQ2FRRk5VeCtMYldaNEVOL1k2OFdNUjd6SkEK",
      "endpoints": [
        "https://github.com/Gubbitkeytoday/diskwhy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}