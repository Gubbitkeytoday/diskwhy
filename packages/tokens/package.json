{
  "name": "@nova/tokens",
  "version": "0.1.0",
  "description": "Nova design tokens (W3C DTCG) compiled to CSS variables, a Tailwind v4 theme, JS/TS and Figma-ready JSON.",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./tailwind": "./dist/tailwind/theme.css",
    "./tailwind.css": "./dist/tailwind/theme.css",
    "./figma/*": "./dist/figma/*",
    "./dtcg/*": "./dist/dtcg/*",
    "./json/*": "./dist/json/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs && node check-contrast.mjs",
    "test": "node check-contrast.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "culori": "^4.0.2",
    "style-dictionary": "5.6.1",
    "typescript": "7.0.2"
  }
}
