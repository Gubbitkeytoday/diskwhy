    },
    "full": {
      "$value": "9999px"
    }
  },
  "space": {
    "base": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$description": "Spacing unit. Tailwind `p-4` = 4 × base = 1rem."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter Variable",
          "Inter",
          "IBM Plex Sans Thai",
          "Noto Sans Thai",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "UI text. Latin = Inter, Thai = IBM Plex Sans Thai."
      },
      "display": {
        "$value": [
          "Inter Variable",
          "Inter",
          "IBM Plex Sans Thai Looped",
          "IBM Plex Sans Thai",
          "ui-sans-serif",
