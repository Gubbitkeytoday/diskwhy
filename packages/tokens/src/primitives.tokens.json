    },
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.5rem"
    },
    "xl": {
      "$value": "0.75rem"
    },
    "2xl": {
