      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      }
    },
    "line-height": {
      "$type": "dimension",
      "$description": "Paired with font.size. Taller than Latin-only systems so Thai vowels/tone marks never clip.",
      "xs": {
        "$value": "1.25rem"
      },
      "sm": {
        "$value": "1.5rem"
      },
      "base": {
        "$value": "1.625rem"
      },
      "lg": {
        "$value": "1.75rem"
      },
      "xl": {
        "$value": "1.875rem"
