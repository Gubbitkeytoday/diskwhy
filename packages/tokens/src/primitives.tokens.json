      },
      "3xl": {
        "$value": "2.5rem"
      },
      "4xl": {
        "$value": "2.875rem"
      },
      "5xl": {
        "$value": "3.5rem"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": {
      "$value": {
        "color": "oklch(0.2 0.02 262 / 0.06)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "sm": {
      "$value": [
        {
          "color": "oklch(0.2 0.02 262 / 0.08)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        },
        {
          "color": "oklch(0.2 0.02 262 / 0.06)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "-1px"
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": "oklch(0.2 0.02 262 / 0.08)",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-2px"
        },
        {
          "color": "oklch(0.2 0.02 262 / 0.06)",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px"
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": "oklch(0.2 0.02 262 / 0.10)",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "24px",
          "spread": "-4px"
        },
        {
          "color": "oklch(0.2 0.02 262 / 0.06)",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-4px"
        }
      ]
    },
    "xl": {
      "$value": [
        {
          "color": "oklch(0.2 0.02 262 / 0.14)",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "48px",
          "spread": "-12px"
        }
      ]
    }
  },
  "duration": {
    "$type": "duration",
    "instant": {
      "$value": "0ms"
    },
    "fast": {
      "$value": "120ms"
    },
    "normal": {
      "$value": "200ms"
    },
    "slow": {
      "$value": "320ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "emphasized": {
      "$value": [
        0.3,
        0,
        0,
        1
      ]
    },
    "in": {
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    },
    "out": {
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    }
  }
}
